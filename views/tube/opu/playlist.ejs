<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= res.title || "再生リスト" %></title>
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
</head>
<body class="bg-gray-900 text-white">

<header class="bg-gray-800 p-4 flex justify-between items-center fixed top-0 left-0 w-full z-10">
    <form action="/wkt/s" method="get" class="w-1/2 relative" id="searchForm">
        <input type="text" name="q" id="searchbox" placeholder="検索" value="<%= typeof query !== 'undefined' ? query : '' %>" class="searchbox w-full p-2 pr-10 rounded bg-gray-700 text-white">
        <button type="button" id="clearBtn" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-6 w-6 rounded-full hover:bg-gray-400 text-white text-lg leading-none hidden">
         ×
        </button>
    </form>
    <nav class="space-x-4">
        <a href="/wkt" class="text-gray-300 hover:text-white">ホーム</a>
        <a href="/wkt/trend" class="text-gray-300 hover:text-white">トレンド</a>
        <a href="/wkt/cl/fav" class="text-gray-300 hover:text-white">お気に入り</a>
        <a href="/wkt/cl/history" class="text-gray-300 hover:text-white">再生履歴</a>
    </nav>
</header>

<div class="container mx-auto p-3 mt-20">

    <%# ===== 再生リストヘッダー ===== %>
    <div class="bg-gray-800 p-8 rounded-lg shadow-lg mt-4">
        <div class="flex flex-col md:flex-row items-start gap-6">
            <%# サムネイル %>
            <% const thumb = res.bestThumbnail?.url || res.thumbnails?.[0]?.url || ''; %>
            <% if (thumb) { %>
            <div class="flex-shrink-0 w-full md:w-64">
                <img src="<%= thumb %>" alt="<%= res.title %>" class="w-full rounded-lg aspect-video object-cover">
            </div>
            <% } %>
            <%# メタ情報 %>
            <div class="flex-1 min-w-0">
                <h1 class="text-3xl font-bold mb-3"><%= res.title || '' %></h1>
                <% if (res.author) { %>
                <a href="/wkt/c/<%= res.author.channelID %>" class="flex items-center gap-3 mb-3 group w-fit">
                    <% if (res.author.bestAvatar?.url) { %>
                    <img src="<%= res.author.bestAvatar.url %>" alt="<%= res.author.name %>" class="w-8 h-8 rounded-full">
                    <% } %>
                    <span class="text-gray-300 group-hover:text-white font-medium transition"><%= res.author.name || '' %></span>
                </a>
                <% } %>
                <% if (res.estimatedItemCount) { %>
                <p class="text-gray-400 text-sm mb-2"><%= res.estimatedItemCount %> 本の動画</p>
                <% } %>
                <% if (res.lastUpdated) { %>
                <p class="text-gray-500 text-sm mb-3"><%= res.lastUpdated %></p>
                <% } %>
                <% if (res.description) { %>
                <p class="text-gray-400 text-sm leading-relaxed line-clamp-3"><%= res.description %></p>
                <% } %>
            </div>
        </div>
    </div>

    <%# ===== 動画リスト ===== %>
    <div class="mt-6">
        <% if (res.items && res.items.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% res.items.forEach((item, i) => { %>
            <div class="result-item bg-gray-800 p-4 rounded-lg shadow hover:bg-gray-700 transition duration-200">
                <a href="/wkt/watch/<%= item.id %>?list=<%= playlistId %>" class="block relative group">
                    <img loading="lazy"
                         src="/wkt/back/vi/<%= item.id %>/mqdefault.jpg"
                         alt="<%= item.title %>"
                         class="w-full h-auto rounded aspect-video object-cover">
                    <% if (item.isLive) { %><span class="absolute bottom-1 right-1 bg-red-600 bg-opacity-90 text-white text-xs px-1.5 py-0.5 rounded font-medium">ライブ</span><% } else if (item.duration) { %>
                    <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium"><%= item.duration %></span>
                    <% } %>
                    <span class="absolute top-1 left-1 bg-black bg-opacity-60 text-white text-xs px-1.5 py-0.5 rounded"><%= item.index > 0 ? item.index : i + 1 %></span>
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                </a>
                <div class="mt-3">
                    <a href="/wkt/watch/<%= item.id %>?list=<%= playlistId %>">
                        <p class="text-white font-bold text-sm leading-snug line-clamp-2 mb-1 hover:text-blue-400 transition"><%= item.title %></p>
                    </a>
                    <% if (item.author?.name) { %>
                    <a href="<%= item.author.channelID ? '/wkt/c/' + item.author.channelID : '/wkt/watch/' + item.id + '?list=' + playlistId %>" class="text-gray-400 text-xs hover:text-gray-200 transition"><%= item.author.name %></a>
                    <% } %>
                </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <p class="text-gray-400 py-12 text-center">動画がありません。</p>
        <% } %>
    </div>
</div>

<script>
const searchBox = document.getElementById('searchbox');
const clearBtn = document.getElementById('clearBtn');
function toggleClearButton() {
    clearBtn.style.display = searchBox.value ? 'block' : 'none';
}
searchBox.addEventListener('input', toggleClearButton);
clearBtn.addEventListener('click', () => {
   searchBox.value = '';
   searchBox.focus();
   toggleClearButton();
});
toggleClearButton();
</script>
</body>
</html>
